{
    "name": "spiral/otel-bridge",
    "description": "OpenTelemetry bridge for Spiral Framework",
    "keywords": [
        "Spiral",
        "spiral framework",
        "opentelemetry",
        "telemetry",
        "OTEL"
    ],
    "homepage": "https://github.com/spiral/otel-bridge",
    "license": "MIT",
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/spiral"
        }
    ],
    "authors": [
        {
            "name": "butschster",
            "email": "butschster@gmail.com",
            "role": "Developer"
        },
        {
            "name": "Aleksei Gagarin",
            "email": "alexey.gagarin@spiralscout.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "open-telemetry/api": "^1.1",
        "open-telemetry/sdk": "^1.3",
        "spiral/boot": "^3.14.6",
        "spiral/core": "^3.14.6",
        "spiral/events": "^3.14.6",
        "spiral/telemetry": "^3.14.6"
    },
    "conflict": {
        "open-telemetry/sem-conv": "<1.22"
    },
    "require-dev": {
        "buggregator/trap": "^1.17",
        "jasonmccreary/double": "^1.0.1",
        "llm/skills": "^1.14",
        "nyholm/psr7": "^1.8",
        "open-telemetry/exporter-otlp": "^1.4",
        "roxblnfk/unpoly": "^1.8",
        "spiral/code-style": "^2.4",
        "spiral/dumper": "^3.3",
        "spiral/testing": "4.x-dev as 4.0.0",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0",
        "testo/bridge-double": "^0.1.1",
        "testo/testo": "^0.10.54",
        "vimeo/psalm": "^6 || ^7"
    },
    "autoload": {
        "psr-4": {
            "Spiral\\OpenTelemetry\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spiral\\OpenTelemetry\\Tests\\Acceptance\\": "tests/Acceptance",
            "Spiral\\OpenTelemetry\\Tests\\Feature\\": "tests/Feature",
            "Spiral\\OpenTelemetry\\Tests\\Unit\\": "tests/Unit"
        }
    },
    "scripts": {
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff",
        "cs:fix": "php-cs-fixer fix -v",
        "psalm": "psalm",
        "psalm:baseline": "psalm --set-baseline=psalm-baseline.xml",
        "psalm:ci": "psalm --output-format=github --shepherd --show-info=false --stats --threads=4",
        "test": "testo",
        "test:acceptance": "testo --suite=Acceptance",
        "test:feature": "testo --suite=Feature",
        "test:unit": "testo --suite=Unit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false,
            "spiral/composer-publish-plugin": false,
            "tbachert/spi": false,
            "llm/skills": true
        }
    },
    "extra": {
        "spiral": {
            "bootloaders": [
                "Spiral\\OpenTelemetry\\Bootloader\\OpenTelemetryBootloader"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
