{
    "name": "spiral/otel-bridge",
    "description": "OpenTelemetry bridge for Spiral Framework",
    "keywords": [
        "Spiral",
        "spiral framework",
        "opentelemetry",
        "telemetry",
        "OTEL"
    ],
    "homepage": "https://github.com/spiral/otel-bridge",
    "license": "MIT",
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/spiral"
        }
    ],
    "authors": [
        {
            "name": "butschster",
            "email": "butschster@gmail.com",
            "role": "Developer"
        },
        {
            "name": "Aleksei Gagarin",
            "email": "alexey.gagarin@spiralscout.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "open-telemetry/api": "^1.7",
        "open-telemetry/context": "^1.4",
        "open-telemetry/sdk": ">=1.9 <1.16",
        "spiral/boot": "^3.17.2",
        "spiral/core": "^3.17.2",
        "spiral/events": "^3.17.2",
        "spiral/exceptions": "^3.17.2",
        "spiral/telemetry": "^3.17.2",
        "tbachert/spi": "^1.0.5"
    },
    "conflict": {
        "open-telemetry/opentelemetry-auto-psr15": "<1.0.6 || >=1.4",
        "open-telemetry/sem-conv": "<1.22"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.8",
        "buggregator/trap": "^1.17",
        "jasonmccreary/double": "^1.0.1",
        "llm/skills": "^1.14",
        "nyholm/psr7": "^1.8",
        "open-telemetry/exporter-otlp": "^1.4",
        "roxblnfk/unpoly": "^1.8",
        "spiral/dumper": "^3.3",
        "spiral/testing": "4.x-dev as 4.0.0",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0",
        "testo/bridge-double": "^0.1.1",
        "testo/bridge-infection": "^0.1.9",
        "testo/testo": "^0.10.54"
    },
    "suggest": {
        "ext-opentelemetry": "To add the spans of auto-instrumentation packages to the Spiral traces"
    },
    "autoload": {
        "psr-4": {
            "Spiral\\OpenTelemetry\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spiral\\OpenTelemetry\\Tests\\Acceptance\\": "tests/Acceptance",
            "Spiral\\OpenTelemetry\\Tests\\Feature\\": "tests/Feature",
            "Spiral\\OpenTelemetry\\Tests\\Support\\": "tests/Support",
            "Spiral\\OpenTelemetry\\Tests\\Unit\\": "tests/Unit"
        }
    },
    "scripts": {
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff --config=tools/code-style/.php-cs-fixer.dist.php",
        "cs:fix": "php-cs-fixer fix -v --config=tools/code-style/.php-cs-fixer.dist.php",
        "infect": [
            "@putenv XDEBUG_MODE=coverage",
            "infection --threads=max --min-msi=90 --min-covered-msi=90"
        ],
        "infect:ci": [
            "@putenv XDEBUG_MODE=coverage",
            "infection --ansi --threads=max --logger-github --show-mutations=0 --min-msi=90 --min-covered-msi=90"
        ],
        "psalm": "psalm -c tools/psalm/psalm.xml",
        "psalm:baseline": "psalm -c tools/psalm/psalm.xml --set-baseline=tools/psalm/psalm-baseline.xml",
        "psalm:ci": "psalm -c tools/psalm/psalm.xml --output-format=github --shepherd --show-info=false --stats --threads=4",
        "structarmed": "structarmed analyze --config=tools/structarmed/structarmed.php",
        "test": "testo",
        "test:acceptance": "testo --suite=Acceptance",
        "test:feature": "testo --suite=Feature",
        "test:unit": "testo --suite=Unit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "php-http/discovery": false,
            "spiral/composer-publish-plugin": false,
            "tbachert/spi": false,
            "llm/skills": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": false,
            "target-directory": "tools"
        },
        "spiral": {
            "bootloaders": [
                "Spiral\\OpenTelemetry\\Bootloader\\OpenTelemetryBootloader"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
